source "https://rubygems.org"

# Gói thư viện cốt lõi tương thích 100% với máy chủ GitHub Pages
gem "github-pages", group: :jekyll_plugins

# Tối ưu thẻ hiển thị khi chia sẻ link lên Facebook/Google
gem "jekyll-seo-tag", group: :jekyll_plugins

# Tự động tạo sơ đồ sitemap hỗ trợ tìm kiếm
gem "jekyll-sitemap", group: :jekyll_plugins

# Thư viện hỗ trợ chạy máy chủ xem trước trên máy tính
gem "webrick"
